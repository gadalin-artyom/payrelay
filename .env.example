# PayRelay — пример локальных переменных окружения (не секреты продакшена).
# Скопируйте в `.env` и подставьте свои значения. Файл `.env` не коммитится.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_DOCS=true

# PostgreSQL (async SQLAlchemy DSN)
DATABASE_URL=postgresql+asyncpg://payrelay:payrelay@postgres:5432/payrelay

# RabbitMQ
RABBITMQ_URL=amqp://payrelay:payrelay@rabbitmq:5672/

# Статический API-ключ (смените на уникальный)
API_KEY=change-me-local-api-key

# Webhook
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_CONNECT_TIMEOUT_SECONDS=2
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_ALLOW_PRIVATE_URLS=false
WEBHOOK_RETRY_DELAY_2_SECONDS=2
WEBHOOK_RETRY_DELAY_4_SECONDS=4
WEBHOOK_RECOVERY_BATCH_SIZE=50

# Outbox publisher
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=30
OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
OUTBOX_RETRY_MAX_DELAY_SECONDS=30
OUTBOX_SHUTDOWN_GRACE_SECONDS=15
OUTBOX_BROKER_RECONNECT_DELAY_SECONDS=2
OUTBOX_DB_RETRY_DELAY_SECONDS=2

# Payment processing / consumer
PROCESSING_LEASE_SECONDS=60
PROCESSING_PREFETCH_COUNT=1
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
CONSUMER_SHUTDOWN_GRACE_SECONDS=30

# Compose / Postgres bootstrap (используются сервисом postgres)
POSTGRES_USER=payrelay
POSTGRES_PASSWORD=payrelay
POSTGRES_DB=payrelay

# Compose / RabbitMQ bootstrap
RABBITMQ_DEFAULT_USER=payrelay
RABBITMQ_DEFAULT_PASS=payrelay
