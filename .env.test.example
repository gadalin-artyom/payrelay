# PayRelay — пример переменных для Compose profile `test`.
# Скопируйте в `.env.test` при необходимости. Не используйте prod-секреты.

APP_ENV=test
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_DOCS=false

DATABASE_URL=postgresql+asyncpg://payrelay_test:payrelay_test@postgres-test:5432/payrelay_test
RABBITMQ_URL=amqp://payrelay_test:payrelay_test@rabbitmq-test:5672/

API_KEY=test-api-key-not-for-production

WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_ALLOW_PRIVATE_URLS=true

OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_CLAIM_SECONDS=30

PROCESSING_LEASE_SECONDS=60
PROCESSING_PREFETCH_COUNT=10

POSTGRES_USER=payrelay_test
POSTGRES_PASSWORD=payrelay_test
POSTGRES_DB=payrelay_test

RABBITMQ_DEFAULT_USER=payrelay_test
RABBITMQ_DEFAULT_PASS=payrelay_test
